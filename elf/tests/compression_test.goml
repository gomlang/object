package tests;

use ecosystem::object::elf;
use std::bytes;
use std::fs;
use std::testing;

fn compressed_fixture(width: isize, order: string, suffix: string) -> bytes::Bytes {
    testing::expect_ok(
        fs::read_bytes_structured(f"elf/tests/data/compressed{width}{order}{suffix}.bin"),
        "compressed fixture",
    )
}

fn compression_number(data: bytes::Bytes, offset: isize, width: isize, value: u64, order: string) -> () {
    for index in 0..width {
        let shift = if order == "le" {
            index * 8
        } else {
            (width - index - 1) * 8
        };
        data.set(offset + index, (value >> shift).to_u8());
    }
}

fn compressed_file(data: bytes::Bytes) -> elf::File {
    testing::expect_ok(elf::parse(data.as_slice()), "compressed ELF parse")
}

#[test]
fn compressed_sections_match_independent_zlib_and_keep_raw_data_owned() -> () {
    for width in[32, 64] {
        for order in["le", "be"] {
            for suffix in["", "_empty"] {
                let data = compressed_fixture(width, order, suffix);
                let file = compressed_file(data);
                let header = testing::expect_some(
                    testing::expect_ok(file.section_compression(1), "compression header"),
                    "compressed",
                );
                testing::assert_eq(header.kind, 1);
                testing::assert_eq(header.alignment, 16);
                let length = if suffix == "" {
                    1024
                } else {
                    0
                };
                testing::assert_eq(header.size, length.to_u64());
                let limits = elf::DecompressionLimits::standard();
                let output = testing::expect_ok(
                    file.section_uncompressed_data(1, limits),
                    "decompress",
                );
                testing::assert_eq(output.len(), length);
                for index in 0..length {
                    testing::assert_eq(output.get(index), (index % 256).to_u8());
                }
                let raw = testing::expect_ok(file.section_data(1), "raw");
                testing::assert_eq(
                    raw.len().to_u64(),
                    testing::expect_some(file.section(1), "section").size,
                );
                raw.set(0, 255);
                data.set(128, 255);
                if length > 0 {
                    output.set(0, 255);
                }
                let fresh = testing::expect_ok(
                    file.section_uncompressed_data(1, limits),
                    "ownership",
                );
                if length > 0 {
                    testing::assert_eq(fresh.get(0), 0);
                }
                testing::assert(testing::expect_ok(file.section_compression(0), "null").is_none());
                testing::assert_err(file.section_compression(-1));
                testing::assert_err(file.section_uncompressed_data(2, limits));
            }
        }
    }
}

#[test]
fn compressed_headers_reject_truncation_reserved_alignment_and_unsupported_codecs() -> () {
    for width in[32, 64] {
        for order in["le", "be"] {
            let word = width / 8;
            let section = 512
                + if width == 64 {
                    64
                } else {
                    40
                };
            let size_offset = section
                + if width == 64 {
                    32
                } else {
                    20
                };
            let header_size = if width == 64 {
                24
            } else {
                12
            };
            for size in 0..header_size {
                let data = compressed_fixture(width, order, "");
                compression_number(data, size_offset, word, size.to_u64(), order);
                testing::assert_err(compressed_file(data).section_compression(1));
            }
            let data = compressed_fixture(width, order, "");
            compression_number(
                data,
                128
                    + if width == 64 {
                        16
                    } else {
                        8
                    },
                word,
                3,
                order,
            );
            testing::assert_err(compressed_file(data).section_compression(1));
            for alignment in[0, 1, 16] {
                let data = compressed_fixture(width, order, "");
                compression_number(
                    data,
                    128
                        + if width == 64 {
                            16
                        } else {
                            8
                        },
                    word,
                    alignment.to_u64(),
                    order,
                );
                testing::assert_ok(compressed_file(data).section_compression(1));
            }
            if width == 64 {
                let data = compressed_fixture(width, order, "");
                compression_number(data, 132, 4, 1, order);
                testing::assert_err(compressed_file(data).section_compression(1));
            }
            for codec in[0, 2, 99] {
                let data = compressed_fixture(width, order, "");
                compression_number(data, 128, 4, codec.to_u64(), order);
                let file = compressed_file(data);
                testing::assert_eq(
                    testing::expect_some(
                        testing::expect_ok(file.section_compression(1), "unknown metadata"),
                        "header",
                    ).kind,
                    codec.to_u32(),
                );
                testing::assert_err(
                    file.section_uncompressed_data(1, elf::DecompressionLimits::standard()),
                );
            }
            for kind in[0, 8] {
                let data = compressed_fixture(width, order, "");
                compression_number(data, section + 4, 4, kind.to_u64(), order);
                testing::assert_err(compressed_file(data).section_compression(1));
            }
            for file_type in[1, 2, 3] {
                let data = compressed_fixture(width, order, "");
                compression_number(data, 16, 2, file_type.to_u64(), order);
                compression_number(data, section + 8, word, 0x802, order);
                let result = compressed_file(data).section_uncompressed_data(
                    1,
                    elf::DecompressionLimits::standard(),
                );
                if file_type == 1 {
                    testing::assert_ok(result);
                } else {
                    testing::assert_err(result);
                }
            }
        }
    }
}

#[test]
fn decompression_rejects_wrong_sizes_bad_checksums_truncation_and_trailing_input() -> () {
    for width in[32, 64] {
        for order in["le", "be"] {
            let word = width / 8;
            let section = 512
                + if width == 64 {
                    64
                } else {
                    40
                };
            let size_offset = section
                + if width == 64 {
                    32
                } else {
                    20
                };
            let header_size = if width == 64 {
                24
            } else {
                12
            };
            for declared in[0, 1023, 1025] {
                let data = compressed_fixture(width, order, "");
                compression_number(
                    data,
                    128
                        + if width == 64 {
                            8
                        } else {
                            4
                        },
                    word,
                    declared.to_u64(),
                    order,
                );
                testing::assert_err(
                    compressed_file(data).section_uncompressed_data(
                        1,
                        elf::DecompressionLimits::standard(),
                    ),
                );
            }
            let source = compressed_fixture(width, order, "");
            let size = testing::expect_some(compressed_file(source).section(1), "section").size.to_isize();
            for length in header_size..size {
                let data = compressed_fixture(width, order, "");
                compression_number(data, size_offset, word, length.to_u64(), order);
                testing::assert_err(
                    compressed_file(data).section_uncompressed_data(
                        1,
                        elf::DecompressionLimits::standard(),
                    ),
                );
            }
            let data = compressed_fixture(width, order, "");
            data.set(128 + size - 1, data.get(128 + size - 1) ^ 1);
            testing::assert_err(
                compressed_file(data).section_uncompressed_data(
                    1,
                    elf::DecompressionLimits::standard(),
                ),
            );
            let data = compressed_fixture(width, order, "");
            compression_number(data, size_offset, word, (size + 1).to_u64(), order);
            testing::assert_err(
                compressed_file(data).section_uncompressed_data(
                    1,
                    elf::DecompressionLimits::standard(),
                ),
            );
        }
    }
}

#[test]
fn decompression_limits_apply_before_output_and_cover_work_blocks_and_plain_sections() -> () {
    let file = compressed_file(compressed_fixture(64, "le", ""));
    let size = testing::expect_some(file.section(1), "section").size.to_isize();
    let limits = elf::DecompressionLimits {
        max_input_bytes: size,
        max_output_bytes: 1024,
        max_blocks: 100,
        max_work: 1000000,
    };
    testing::assert_ok(file.section_uncompressed_data(1, limits));
    for failed in[
        elf::DecompressionLimits { max_input_bytes: size - 1, ..limits },
        elf::DecompressionLimits { max_output_bytes: 1023, ..limits },
        elf::DecompressionLimits { max_blocks: 0, ..limits },
        elf::DecompressionLimits { max_work: 0, ..limits },
        elf::DecompressionLimits { max_input_bytes: -1, ..limits },
        elf::DecompressionLimits { max_output_bytes: -1, ..limits },
        elf::DecompressionLimits { max_blocks: -1, ..limits },
        elf::DecompressionLimits { max_work: -1, ..limits },
    ] {
        match testing::expect_err(file.section_uncompressed_data(1, failed), "limit") {
            elf::Error::LimitExceeded(_) => (),
            _ => testing::fail("expected limit error"),
        }
    }
    let data = compressed_fixture(64, "le", "");
    compression_number(data, 136, 8, 0xffffffffffffffff, "le");
    testing::assert_err(compressed_file(data).section_uncompressed_data(1, limits));
    let data = compressed_fixture(64, "le", "");
    compression_number(data, 584, 8, 0, "le");
    let plain = compressed_file(data);
    testing::assert(testing::expect_ok(plain.section_compression(1), "plain").is_none());
    testing::assert_eq(
        testing::expect_ok(plain.section_uncompressed_data(1, limits), "plain").len(),
        size,
    );
    testing::assert_err(
        plain.section_uncompressed_data(
            1,
            elf::DecompressionLimits { max_output_bytes: size - 1, ..limits },
        ),
    );
    let zero = elf::DecompressionLimits {
        max_input_bytes: 0,
        max_output_bytes: 0,
        max_blocks: 0,
        max_work: 0,
    };
    testing::assert_eq(
        testing::expect_ok(plain.section_uncompressed_data(0, zero), "null").len(),
        0,
    );
    let empty = compressed_file(compressed_fixture(64, "le", "_empty"));
    testing::assert_ok(
        empty.section_uncompressed_data(
            1,
            elf::DecompressionLimits { max_output_bytes: 0, ..limits },
        ),
    );
}
