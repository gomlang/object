package tests;

use ecosystem::object::elf;
use std::bytes;
use std::fs;
use std::testing;

fn version_fixture(bits: string, order: string) -> bytes::Bytes {
    testing::expect_ok(
        fs::read_bytes_structured("elf/tests/data/versions" + bits + order + ".bin"),
        "version fixture",
    )
}

fn version_file() -> elf::File {
    testing::expect_ok(elf::parse(version_fixture("64", "le").as_slice()), "parse")
}

fn version_mutation(offset: isize, value: u64, width: isize) -> elf::File {
    let data = version_fixture("64", "le");
    set_number(data, offset, value, width);
    testing::expect_ok(elf::parse(data.as_slice()), "parse mutated metadata lazily")
}

#[test]
fn versions_all_classes_and_byte_orders() -> () {
    for bits in["32", "64"] {
        for order in["le", "be"] {
            let file = testing::expect_ok(
                elf::parse(version_fixture(bits, order).as_slice()),
                "parse versions",
            );
            let limits = elf::VersionLimits::standard();
            let defs = testing::expect_ok(
                file.section_version_definitions(4, limits),
                "definitions",
            );
            testing::assert_eq(defs.len(), 2);
            testing::assert_eq(defs[0].index, 1);
            testing::assert_eq(defs[0].flags, 1);
            testing::assert_eq(defs[0].name, "self.so");
            testing::assert_eq(defs[1].index, 2);
            testing::assert_eq(defs[1].name, "CUSTOM_2");
            testing::assert_eq(defs[1].dependencies.len(), 1);
            testing::assert_eq(defs[1].dependencies[0], "BASE_1");
            let needs = testing::expect_ok(file.section_version_needs(5, limits), "needs");
            testing::assert_eq(needs.len(), 1);
            testing::assert_eq(needs[0].library, "libc.so.6");
            testing::assert_eq(needs[0].dependencies.len(), 2);
            testing::assert_eq(needs[0].dependencies[0].name, "GLIBC_2.2.5");
            testing::assert_eq(needs[0].dependencies[1].index, 4);
            testing::assert(!needs[0].dependencies[1].hidden);
            testing::assert_eq(needs[0].dependencies[1].flags, 2);
            let versions = testing::expect_ok(
                file.section_symbol_versions(3, limits),
                "symbol versions",
            );
            testing::assert_eq(versions.len(), 5);
            testing::assert_eq(file.dynamic_symbols().len(), 4);
            testing::assert_eq(versions[0].symbol_index, 0);
            testing::assert_eq(versions[0].index, 0);
            testing::assert(versions[0].name == Option::None);
            testing::assert_eq(versions[1].symbol_index, 1);
            testing::assert_eq(versions[1].symbol_table_section, 2);
            testing::assert_eq(file.dynamic_symbols()[versions[1].symbol_index - 1].name, "defined");
            testing::assert_eq(versions[1].index, 2);
            testing::assert(versions[1].hidden);
            testing::assert(versions[1].name == Option::Some("CUSTOM_2"));
            testing::assert(versions[1].library == Option::None);
            testing::assert(versions[2].name == Option::Some("GLIBC_2.2.5"));
            testing::assert(versions[2].library == Option::Some("libc.so.6"));
            testing::assert_eq(versions[3].index, 1);
            testing::assert(versions[3].name == Option::None);
            testing::assert(versions[4].hidden);
        }
    }
}

#[test]
fn version_disjoint_auxiliary_layout() -> () {
    let data = version_fixture("64", "le");
    // Two headers first, followed by the first and second definitions' aux lists.
    let source = bytes::Bytes::from_slice_copy(data.as_slice());
    for i in 0..20 {
        data.set(448 + 20 + i, source.get(448 + 28 + i));
    }
    for i in 0..8 {
        data.set(448 + 40 + i, source.get(448 + 20 + i));
    }
    set_number(data, 448 + 12, 40, 4);
    set_number(data, 448 + 16, 20, 4);
    set_number(data, 448 + 20 + 12, 28, 4);
    let file = testing::expect_ok(elf::parse(data.as_slice()), "interleaved parse");
    let defs = testing::expect_ok(
        file.section_version_definitions(4, elf::VersionLimits::standard()),
        "disjoint aux",
    );
    testing::assert_eq(defs[0].name, "self.so");
    testing::assert_eq(defs[1].name, "CUSTOM_2");
    testing::assert_eq(defs[1].dependencies.len(), 1);
    testing::assert_eq(defs[1].dependencies[0], "BASE_1");
}

#[test]
fn version_chains_reject_invalid_counts_offsets_and_formats() -> () {
    let limits = elf::VersionLimits::standard();
    for mutation in[
        (448, 2, 2),
        (454, 0, 2),
        (460, 0, 4),
        (464, 0, 4),
        (464, 19, 4),
        (464, 0xffffffff, 4),
        (472, 8, 4),
        (492, 28, 4),
        (500, 0, 4),
        (508, 8, 4),
        (1024 + 4 * 64 + 44, 1, 4),
        (1024 + 4 * 64 + 32, 63, 8),
    ] {
        testing::assert_err(
            version_mutation(mutation.0, mutation.1.to_u64(), mutation.2).section_version_definitions(
                4,
                limits,
            ),
        );
    }
    for mutation in[
        (544, 2, 2),
        (546, 1, 2),
        (546, 3, 2),
        (552, 0, 4),
        (556, 16, 4),
        (572, 0, 4),
        (572, 15, 4),
        (588, 16, 4),
        (1024 + 5 * 64 + 32, 47, 8),
    ] {
        testing::assert_err(
            version_mutation(mutation.0, mutation.1.to_u64(), mutation.2).section_version_needs(
                5,
                limits,
            ),
        );
    }
}

#[test]
fn version_strings_indices_and_links_are_validated() -> () {
    let limits = elf::VersionLimits::standard();
    testing::assert_err(version_mutation(468, 0xffffffff, 4).section_version_definitions(4, limits));
    testing::assert_err(version_mutation(548, 0xffffffff, 4).section_version_needs(5, limits));
    testing::assert_err(version_mutation(480, 1, 2).section_version_definitions(4, limits));
    testing::assert(
        testing::expect_ok(
            version_mutation(582, 0x8004, 2).section_version_needs(5, limits),
            "hidden need",
        )[0].dependencies[1].hidden,
    );
    testing::assert_err(version_mutation(582, 3, 2).section_version_needs(5, limits));
    testing::assert_err(version_mutation(566, 2, 2).section_symbol_versions(3, limits));
    testing::assert_err(version_mutation(404, 99, 2).section_symbol_versions(3, limits));
    testing::assert_err(
        version_mutation(1024 + 3 * 64 + 40, 1, 4).section_symbol_versions(3, limits),
    );
    testing::assert_err(
        version_mutation(1024 + 4 * 64 + 40, 2, 4).section_version_definitions(4, limits),
    );
    testing::assert_err(
        version_mutation(1024 + 3 * 64 + 32, 8, 8).section_symbol_versions(3, limits),
    );
    testing::assert_err(
        version_mutation(1024 + 3 * 64 + 56, 4, 8).section_symbol_versions(3, limits),
    );
    testing::assert_err(version_file().section_symbol_versions(-1, limits));
    testing::assert_err(version_file().section_version_needs(4, limits));
    // UTF-8 and NUL termination are checked even at string offset zero.
    testing::assert_err(version_mutation(128 + 30, 0xff, 1).section_version_definitions(4, limits));
    let data = version_fixture("64", "le");
    set_number(data, 468, 0, 4);
    set_number(data, 1024 + 1 * 64 + 32, 0, 8);
    // An empty string table would invalidate dynsym too: remove its symbol payload first.
    set_number(data, 1024 + 2 * 64 + 32, 0, 8);
    let file = testing::expect_ok(elf::parse(data.as_slice()), "empty tables");
    testing::assert_err(file.section_version_definitions(4, limits));
}

#[test]
fn version_budgets_are_aggregate_and_include_auxiliary_records() -> () {
    let file = version_file();
    let standard = elf::VersionLimits::standard();
    // 5 versym + 2 verdef + 3 verdaux + 1 verneed + 2 vernaux = 13 records.
    let mut exact = standard;
    exact.max_records = 13;
    exact.max_input_bytes = 10 + 64 + 48;
    exact.max_string_bytes = 11;
    exact.max_total_string_bytes = 7 + 8 + 6 + 9 + 11 + 6;
    testing::assert_ok(file.section_symbol_versions(3, exact));
    let mut small = exact;
    small.max_records -= 1;
    testing::assert_eq(
        testing::expect_err(file.section_symbol_versions(3, small), "record quota"),
        elf::Error::LimitExceeded("version records"),
    );
    small = exact;
    small.max_input_bytes -= 1;
    testing::assert_err(file.section_symbol_versions(3, small));
    small = exact;
    small.max_string_bytes -= 1;
    testing::assert_err(file.section_symbol_versions(3, small));
    small = exact;
    small.max_total_string_bytes -= 1;
    testing::assert_err(file.section_symbol_versions(3, small));
    for which in 0..4 {
        small = standard;
        if which == 0 {
            small.max_records = -1;
        } else if which == 1 {
            small.max_input_bytes = -1;
        } else if which == 2 {
            small.max_string_bytes = -1;
        } else {
            small.max_total_string_bytes = -1;
        }
        testing::assert_err(file.section_symbol_versions(3, small));
    }
}
