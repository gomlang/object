package tests;

use ecosystem::object::examples::basic as example_files;
use ecosystem::object::elf;
use std::bytes;
use std::fs;
use std::testing;

fn relocation_fixture(width: isize, order: string) -> bytes::Bytes {
    testing::expect_ok(
        fs::read_bytes_structured(
            example_files::fixture_path(f"tests/data/reloc{width}{order}.bin"),
        ),
        "fixture",
    )
}

fn relocation_put(raw: bytes::Bytes, offset: isize, width: isize, big: bool, value: u64) -> () {
    for i in 0..width {
        raw.set(
            offset + i,
            (value
                >> ((if big {
                    width - 1 - i
                } else {
                    i
                })
                    * 8)).to_u8(),
        );
    }
}

#[test]
fn relocation_metadata_all_classes_orders_and_signed_addends() -> () {
    for width in[32, 64] {
        for order in["le", "be"] {
            let file = testing::expect_ok(
                elf::parse(relocation_fixture(width, order).as_slice()),
                "ELF",
            );
            let limits = elf::RelocationLimits::standard();
            let rel = testing::expect_ok(file.section_relocations(4, limits), "REL");
            testing::assert_eq(rel.len(), 2);
            testing::assert_eq(rel[0].offset, 4);
            testing::assert_eq(rel[0].symbol_index, 1);
            testing::assert_eq(
                rel[0].kind,
                if width == 64 {
                    0xffffffff
                } else {
                    255
                },
            );
            testing::assert_eq(rel[0].symbol_table_section, 3);
            testing::assert(rel[0].target_section == Option::Some(1));
            testing::assert(rel[0].addend == Option::None);
            testing::assert_eq(rel[1].symbol_index, 0);
            let rela = testing::expect_ok(file.section_relocations(5, limits), "RELA");
            testing::assert_eq(rela.len(), 4);
            testing::assert_eq(rela[0].offset, 8);
            testing::assert_eq(rela[0].kind, 2);
            testing::assert(rela[0].target_section == Option::None);
            let max = if width == 64 {
                9223372036854775807.to_i64()
            } else {
                2147483647.to_i64()
            };
            testing::assert(rela[0].addend == Option::Some(-max - 1));
            testing::assert(rela[1].addend == Option::Some(-1.to_i64()));
            testing::assert(rela[2].addend == Option::Some(0.to_i64()));
            testing::assert(rela[3].addend == Option::Some(max));
            testing::assert_err(file.section_relocations(-1, limits));
            testing::assert_err(file.section_relocations(6, limits));
            testing::assert_err(file.section_relocations(1, limits));
            testing::assert_err(
                file.section_relocations(4, elf::RelocationLimits { max_relocations: 1, ..limits }),
            );
            testing::assert_err(
                file.section_relocations(4, elf::RelocationLimits { max_input_bytes: 0, ..limits }),
            );
            testing::assert_err(
                file.section_relocations(4, elf::RelocationLimits { max_relocations: -1, ..limits }),
            );
            testing::assert_err(
                file.section_relocations(4, elf::RelocationLimits { max_input_bytes: -1, ..limits }),
            );
            testing::assert_ok(
                file.section_relocations(
                    4,
                    elf::RelocationLimits {
                        max_relocations: 2,
                        max_input_bytes: if width == 64 {
                            32
                        } else {
                            16
                        },
                    },
                ),
            );
        }
    }
}

#[test]
fn relocation_invalid_tables_indexes_and_ranges_are_rejected() -> () {
    for bits in[32, 64] {
        for order in["le", "be"] {
            let wide = bits == 64;
            let width = if wide {
                8
            } else {
                4
            };
            let sh = 512
                + 4
                    * if wide {
                        64
                    } else {
                        40
                    };
            let entry = sh
                + if wide {
                    56
                } else {
                    36
                };
            let size = sh
                + if wide {
                    32
                } else {
                    20
                };
            let link = sh
                + if wide {
                    40
                } else {
                    24
                };
            let info = sh
                + if wide {
                    44
                } else {
                    28
                };
            for (offset, n, value) in[
                (entry, width, 0.to_u64()),
                (entry, width, 1.to_u64()),
                (entry, width, (width * 2 + 1).to_u64()),
                (size, width, 1.to_u64()),
                (link, 4, 0.to_u64()),
                (link, 4, 1.to_u64()),
                (link, 4, 6.to_u64()),
                (info, 4, 6.to_u64()),
                (
                    224 + width,
                    width,
                    2.to_u64()
                        << if wide {
                            32
                        } else {
                            8
                        },
                ),
            ] {
                let raw = relocation_fixture(bits, order);
                relocation_put(raw, offset, n, order == "be", value);
                let file = testing::expect_ok(elf::parse(raw.as_slice()), "lazy validation");
                testing::assert_err(file.section_relocations(4, elf::RelocationLimits::standard()));
            }
            let raw = relocation_fixture(bits, order);
            relocation_put(
                raw,
                sh
                    + if wide {
                        24
                    } else {
                        16
                    },
                width,
                order == "be",
                0xffffffff,
            );
            testing::assert_err(elf::parse(raw.as_slice()));
            let raw = relocation_fixture(bits, order);
            relocation_put(raw, size, width, order == "be", 0);
            let file = testing::expect_ok(elf::parse(raw.as_slice()), "empty table");
            testing::assert_eq(
                testing::expect_ok(
                    file.section_relocations(
                        4,
                        elf::RelocationLimits { max_relocations: 0, max_input_bytes: 0 },
                    ),
                    "empty result",
                ).len(),
                0,
            );
            let raw = relocation_fixture(bits, order);
            let sym_sh = 512
                + 3
                    * if wide {
                        64
                    } else {
                        40
                    };
            relocation_put(raw, sym_sh + 4, 4, order == "be", 11);
            let file = testing::expect_ok(elf::parse(raw.as_slice()), "DYNSYM");
            testing::assert_ok(file.section_relocations(4, elf::RelocationLimits::standard()));
        }
    }
}
